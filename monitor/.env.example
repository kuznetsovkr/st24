# Public storefront. The DNS and TLS host default to this URL's hostname.
MONITOR_SITE_URL=https://xn---24-3edf.xn--p1ai
MONITOR_DNS_HOST=xn---24-3edf.xn--p1ai
MONITOR_TLS_HOST=xn---24-3edf.xn--p1ai
MONITOR_TLS_PORT=443

# Relative endpoint values are resolved against MONITOR_SITE_URL.
MONITOR_LIVE_URL=/api/health/live
MONITOR_READY_URL=/api/health/ready
# Required check; a relative URL is resolved against MONITOR_SITE_URL.
MONITOR_NOTIFICATIONS_URL=/api/health/notifications
# This endpoint must execute a real database query (categories does).
MONITOR_CATALOG_URL=/api/categories
MONITOR_CATALOG_MIN_ITEMS=1
MONITOR_HEALTH_MAX_AGE_MS=60000

# Required storefront marker prevents a hosting parking/error page from looking healthy.
MONITOR_HOMEPAGE_MARKER=Купить запчасти для Karcher
# Optional extra marker; catalog JSON schema is validated even when this is empty.
MONITOR_CATALOG_MARKER=

# Network and alert thresholds.
MONITOR_TIMEOUT_MS=10000
MONITOR_MAX_RESPONSE_MS=3000
MONITOR_MAX_BODY_BYTES=1048576
MONITOR_TELEGRAM_MAX_PENDING_UPDATES=100
MONITOR_TLS_WARN_DAYS=30
MONITOR_TLS_CRITICAL_DAYS=7
MONITOR_FAILURE_THRESHOLD=2
MONITOR_RECOVERY_THRESHOLD=1

# Every configured application bot, including disabled inbound bots, is checked
# with getMe and getWebhookInfo through the same proxy as the application.
# Supported proxy schemes: http, https, socks and socks5.
TELEGRAM_OUTBOUND_PROXY_URL=socks5://user:password@proxy.example.com:1080
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_B2B_BOT_TOKEN=
# Required mode per bot: polling, webhook or disabled.
MONITOR_TELEGRAM_MAIN_MODE=polling
MONITOR_TELEGRAM_ORDERS_MODE=polling
MONITOR_TELEGRAM_B2B_MODE=polling
# Required and HTTPS only when the corresponding mode is webhook. Must be empty
# in polling/disabled mode. Use these exact backend routes after your origin:
# main=/api/telegram/webhook, orders=/api/telegram/orders-webhook,
# b2b=/api/telegram/b2b-webhook.
MONITOR_TELEGRAM_MAIN_WEBHOOK_URL=
MONITOR_TELEGRAM_ORDERS_WEBHOOK_URL=
MONITOR_TELEGRAM_B2B_WEBHOOK_URL=
# Required for every configured production token (without @).
MONITOR_TELEGRAM_MAIN_USERNAME=
MONITOR_TELEGRAM_ORDERS_USERNAME=
MONITOR_TELEGRAM_B2B_USERNAME=
# Every configured production bot sends a silent canary here in summary mode.
# Required by `summary`; an ordinary `check` does not send canaries.
MONITOR_TELEGRAM_CANARY_CHAT_ID=

# Alerts must use a separate bot. Its proxy is optional and independent from
# TELEGRAM_OUTBOUND_PROXY_URL, so a failed application proxy can still alert.
MONITOR_TELEGRAM_BOT_TOKEN=
# Optional identity pin, strongly recommended in production (without @).
MONITOR_TELEGRAM_BOT_USERNAME=
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_TELEGRAM_PROXY_URL=

# External HTTPS dead-man endpoint. It must alert if scheduled runs stop.
MONITOR_HEARTBEAT_URL=
# Set true only for a deliberate local/staging run without a dead-man service.
MONITOR_ALLOW_NO_HEARTBEAT=false

# Relative paths are resolved from the process working directory.
MONITOR_STATE_FILE=./.monitor-state.json
