[Unit]
Description=Karcher production API
Documentation=file:/var/www/st24/ops/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=karcher-api
Group=karcher-api

EnvironmentFile=/etc/karcher/api.env

# uploads/, tmp/ and the readiness write probe are resolved from cwd. These
# paths are provisioned by ops/tmpfiles/karcher-api.conf.
WorkingDirectory=/var/www/st24/server
LogsDirectory=karcher-api
LogsDirectoryMode=0750
ReadWritePaths=/var/www/st24/server/uploads /var/www/st24/server/tmp

# Command-local assignments deliberately override duplicate values from the
# EnvironmentFile. This keeps the service in production mode even if a copied
# development template still contains NODE_ENV=development.
ExecStartPre=/usr/bin/test -r /var/www/st24/server/dist/configCheck.js
ExecStartPre=/usr/bin/env NODE_ENV=production DOTENV_CONFIG_PATH=/etc/karcher/api.env DOTENV_CONFIG_QUIET=true /usr/bin/node /var/www/st24/server/dist/configCheck.js
ExecStartPre=/usr/bin/test -r /var/www/st24/server/dist/index.js
ExecStart=/usr/bin/env NODE_ENV=production DOTENV_CONFIG_PATH=/etc/karcher/api.env DOTENV_CONFIG_QUIET=true /usr/bin/node /var/www/st24/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=30s
KillSignal=SIGTERM

StandardOutput=append:/var/log/karcher-api/api.log
StandardError=inherit
UMask=0027

# The process needs outbound TCP/UDP and write access only to StateDirectory.
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
