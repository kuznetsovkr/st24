[Unit]
Description=Karcher host inbound firewall (isolated nftables table)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target systemd-modules-load.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/karcher-security/load-firewall.sh
ExecReload=/usr/local/lib/karcher-security/load-firewall.sh
TimeoutStartSec=30s
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/lock
RestrictAddressFamilies=AF_NETLINK AF_UNIX

# No ExecStop: stopping the unit must not silently remove a verified firewall.
# Emergency rollback explicitly deletes ONLY inet karcher_ingress.
[Install]
WantedBy=multi-user.target
