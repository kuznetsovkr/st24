# Core backend configuration. Never put real secrets in this tracked template.
NODE_ENV=development
PORT=4000
API_BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/her
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
ADMIN_PHONE=
ADMIN_AUTH_MODE=password
ADMIN_PASSWORD=
# Request IP is used for YooKassa webhook allowlisting. Keep false for direct
# exposure; in production only explicit proxy IP/CIDR entries are accepted.
# The proxy must overwrite forwarded headers; blanket/numeric trust is rejected.
TRUST_PROXY=false

# Public integrations used by the application.
TURNSTILE_SECRET_KEY=
SMS_RU_API_ID=
PHONE_VERIFICATION_MODE=telegram_then_sms
TELEGRAM_GATEWAY_TOKEN=
PHONE_VERIFICATION_BRAND=HER

# YooKassa. Keep secrets empty in the tracked template.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional defense-in-depth header injected by a trusted reverse proxy.
# YooKassa itself does not send this value.
YOOKASSA_WEBHOOK_SECRET=
# Required when YooKassa is enabled in production. Exact public HTTPS origin
# only, without credentials, path, query or fragment (for example https://shop.example.com).
YOOKASSA_RETURN_BASE_URL=
# Production accepts only the official endpoint below; override only in dev/test.
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
# Production storefronts normally charge the real order total.
YOOKASSA_USE_ORDER_TOTAL=true
YOOKASSA_FIXED_AMOUNT_CENTS=100
YOOKASSA_RECEIPT_TAX_SYSTEM_CODE=2
YOOKASSA_RECEIPT_VAT_CODE=1

# All application Bot API calls use this production proxy.
TELEGRAM_OUTBOUND_PROXY_URL=socks5://user:password@proxy.example.com:1080
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_B2B_BOT_TOKEN=
# Required for every configured token. Comma-separated canonical Telegram chat IDs.
# Only active subscribers from these allowlists receive new outbox snapshots.
TELEGRAM_MAIN_ALLOWED_CHAT_IDS=
TELEGRAM_ORDERS_ALLOWED_CHAT_IDS=
TELEGRAM_B2B_ALLOWED_CHAT_IDS=

# Explicit mode for every bot: polling, webhook or disabled. The tracked
# template stays fail-safe; switch a bot only when its token/allowlist and the
# corresponding inbound settings are ready.
TELEGRAM_MAIN_MODE=disabled
TELEGRAM_ORDERS_MODE=disabled
TELEGRAM_B2B_MODE=disabled
# Required only for the corresponding webhook mode; all six values must be
# empty in polling/disabled mode. Public URL routes are exactly:
# main=/api/telegram/webhook, orders=/api/telegram/orders-webhook,
# b2b=/api/telegram/b2b-webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ORDERS_WEBHOOK_SECRET=
TELEGRAM_B2B_WEBHOOK_SECRET=
TELEGRAM_MAIN_WEBHOOK_URL=
TELEGRAM_ORDERS_WEBHOOK_URL=
TELEGRAM_B2B_WEBHOOK_URL=

# Durable Telegram outbox worker and business SLA.
TELEGRAM_OUTBOX_INTERVAL_MS=1000
TELEGRAM_OUTBOX_LEASE_MS=900000
TELEGRAM_OUTBOX_OVERDUE_MS=300000
# Retry/config/auth/network failures become an irrecoverable, scrubbed dead-letter
# after this per-event window. Changing it affects newly created events only.
TELEGRAM_OUTBOX_MAX_RETRY_AGE_DAYS=7
TELEGRAM_OUTBOX_WORKER_STALE_MS=120000
TELEGRAM_POLLING_STALE_MS=120000
TELEGRAM_RUNTIME_PROBE_INTERVAL_MS=60000
TELEGRAM_RUNTIME_PROBE_STALE_MS=120000
TELEGRAM_MAX_PENDING_UPDATES=100
NOTIFICATION_HEALTH_CACHE_TTL_MS=5000

# Retention for payloads/inbox and dead-letter attachments.
TELEGRAM_OUTBOX_RETENTION_DAYS=90
TELEGRAM_UPDATE_INBOX_RETENTION_DAYS=90
TELEGRAM_OUTBOX_DEAD_ATTACHMENT_RETENTION_DAYS=30

# Manual payment is a local-development escape hatch and is always disabled in production.
ENABLE_MANUAL_PAYMENT=false

# Generic backend health limits.
HEALTH_CHECK_TIMEOUT_MS=3000
HEALTH_CHECK_CACHE_TTL_MS=5000
DATABASE_CONNECT_TIMEOUT_MS=10000
