{
  "monitors": [
    {
      "key": "karcher-telegram-notifications",
      "name": "Karcher — Telegram и доставка",
      "type": "check",
      "platform": "http",
      "schedule": "every 5 minutes",
      "request": {
        "url": "https://xn---24-3edf.xn--p1ai/api/health/notifications",
        "method": "GET",
        "timeout_seconds": 10,
        "follow_redirects": false,
        "verify_ssl": true,
        "headers": {
          "Cache-Control": "no-cache"
        }
      },
      "assertions": [
        "response.code = 200",
        "response.header Content-Type contains application/json",
        "response.header Cache-Control contains no-store",
        "response.json status = ok",
        "response.json worker.status = ok",
        "response.json outbox.dead = 0",
        "response.json invariants.failedLeadNotifications = 0"
      ],
      "failure_tolerance": 0,
      "notify": ["default"]
    }
  ]
}
