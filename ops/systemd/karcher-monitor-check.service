[Unit]
Description=Karcher external availability check
Documentation=file:/var/www/st24/ops/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=karcher-monitor
Group=karcher-monitor

EnvironmentFile=/etc/karcher-monitor/monitor.env

WorkingDirectory=/var/www/st24/monitor
StateDirectory=karcher-monitor
StateDirectoryMode=0700
LogsDirectory=karcher-monitor
LogsDirectoryMode=0750

# Command-local assignments take precedence over the EnvironmentFile. The
# protected state path therefore cannot fall back to the template's local path.
ExecStartPre=/usr/bin/test -r /var/www/st24/monitor/dist/configCheck.js
ExecStartPre=/usr/bin/env MONITOR_ENV_FILE=/etc/karcher-monitor/monitor.env MONITOR_STATE_FILE=/var/lib/karcher-monitor/state.json /usr/bin/node /var/www/st24/monitor/dist/configCheck.js check
ExecStartPre=/usr/bin/test -r /var/www/st24/monitor/dist/cli.js
ExecStart=/usr/bin/flock --exclusive --wait 210 --conflict-exit-code 75 /var/lib/karcher-monitor/schedule.lock /usr/bin/env MONITOR_ENV_FILE=/etc/karcher-monitor/monitor.env MONITOR_STATE_FILE=/var/lib/karcher-monitor/state.json /usr/bin/node /var/www/st24/monitor/dist/cli.js check
TimeoutStartSec=4min

StandardOutput=append:/var/log/karcher-monitor/monitor.log
StandardError=inherit
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
