# Public values embedded into the production frontend bundle. Do not put
# server-side secrets in this file.
VITE_API_URL=https://api.shop.example
VITE_SITE_URL=https://shop.example
VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key
VITE_YANDEX_MAPS_API_KEY=replace-with-public-browser-key

# Set at least one CDEK origin. A numeric code takes precedence when both exist.
VITE_CDEK_FROM_CODE=123456
VITE_CDEK_FROM_LOCATION=Krasnoyarsk, Example street 1
VITE_CDEK_DEFAULT_LOCATION=Krasnoyarsk
