{
  "name": "karcher",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce MVP (frontend + backend)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "workspaces": [
    "client",
    "server",
    "monitor"
  ],
  "scripts": {
    "test": "npm run test:client-config && npm run test:deploy-tools && npm run test:backup-config && npm run test:browser:policy && npm run test --workspaces --if-present",
    "test:client-config": "node --test scripts/client-config.test.mjs",
    "test:deploy-tools": "node --test scripts/deploy-readiness.test.mjs scripts/postgres-command.test.mjs scripts/project-names.test.mjs",
    "test:backup-config": "node --test ops/backup/read-database-url.test.mjs",
    "test:browser": "playwright test",
    "test:browser:policy": "node --test tests/browser/network-policy.test.mjs",
    "test:browser:types": "tsc -p tests/browser/tsconfig.json",
    "lint:browser": "eslint playwright.config.ts \"tests/browser/**/*.{ts,mjs}\"",
    "test:ops": "node ops/validate-units.mjs",
    "test:postgres-smoke": "node scripts/ci/postgres-smoke.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "config:check": "npm run config:check --workspace server",
    "client:config:check": "node scripts/client-config.mjs check",
    "client:build": "node scripts/client-config.mjs build",
    "monitor:check": "npm run check --workspace monitor",
    "monitor:summary": "npm run summary --workspace monitor"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.64.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
