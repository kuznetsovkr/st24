{
  "monitors": [
    {
      "key": "karcher-telegram-notifications",
      "name": "Karcher — интеграции",
      "type": "check",
      "platform": "http",
      "schedule": "every 5 minutes",
      "request": {
        "url": "https://xn---24-3edf.xn--p1ai/api/health/integrations",
        "method": "GET",
        "timeout_seconds": 10,
        "follow_redirects": false,
        "verify_ssl": true,
        "headers": { "Cache-Control": "no-cache" }
      },
      "assertions": [
        "response.code = 200",
        "response.header Content-Type contains application/json",
        "response.header Cache-Control contains no-store",
        "response.json availability = ok",
        "response.json checks.postgres.status = ok",
        "response.json checks.uploads.status = ok",
        "response.json checks.telegram.status = ok"
      ],
      "failure_tolerance": 0,
      "notify": ["default"]
    }
  ]
}
